# Bu dosyayı .env olarak kopyala. .env commit edilmez.
DATABASE_URL=postgresql+psycopg://devpulse:devpulse@localhost:5432/devpulse

# Yalnızca komut satırı senkronu (py -m app.sync) için kişisel token. API bunu kullanmaz.
GITHUB_TOKEN=

# GitHub OAuth App: github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Oturum belirteci imza anahtarı. Üret:
#   py -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
